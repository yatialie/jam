  "character_kit": {
    "id": "nova",
    "role": "player default protagonist",
    "dir": "characters/nova",
    "canvas": [
      384,
      384
    ],
    "anchor": "bottom-center",
    "content_height": 336,
    "world_height": 150,
    "source": "_source = S-key (south) 12f; _source_n = W-key (north) 14f; _source_e = D-key (east) 12f; _source_w = A-key (west) 11f; all de-watermarked, height-normalized and re-aligned to a common baseline",
    "idle": "nova_idle_s.png = 28-frame front idle loop (10752x384, cell 384, 24 fps, frames 29-30 trimmed to close the loop); nova_idle_n/e/w.png stay single-frame static idles",
    "idle_note": "front idle scaled 0.72 to match walk head height (140 px), feet baseline 363, head centered at x=192; only the S direction has animated idle because the delivered sheet is front view only",
    "walk_s": "nova_walk_s.png, 12 frames, 4608x384, cell 384",
    "walk_n": "nova_walk_n.png, 14 frames, 5376x384, cell 384, height-normalized to match S",
    "walk_e": "nova_walk_e.png, 12 frames, 4608x384, cell 384, height-normalized to match S",
    "walk_w": "nova_walk_w.png, 11 frames, 4224x384, cell 384, height-normalized to match S",
    "death": "nova_death.png, 20 frames, 7680x384, cell 384, 24 fps, non-looping; source sheet 50 frames trimmed to originals 19-38 (standing -> white impact burst -> collapse -> settled pose), height-normalized to the idle (342 px content) with feet baseline 364 and head center x 191.5; source frames in _source_death with .gdignore",
    "respawn": "nova_respawn.png, 34 frames, 13056x384, cell 384, 30 fps, non-looping; source sheet 46 frames trimmed to originals 13-46 (energy core -> swirling rings -> settle), normalized by the final frame (416 px source) to idle height 342 with feet baseline 364; source frames in _source_respawn with .gdignore",
    "missing": "four cardinals are complete; diagonal sheets and shoot frames are not delivered yet, so NE/NW use N, SE uses E, SW uses W",
    "note": "key naming: art 'S key' = south, 'W key' = north, 'D key' = east, 'A key' = west"
  },
